{
  "name": "@soybeanjs/eslint-config-vue",
  "version": "0.0.2",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "description": "SoybeanJS's eslint config for Vue projects.",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/soybeanjs/eslint-config-vue",
  "repository": {
    "url": "https://github.com/soybeanjs/eslint-config-vue.git"
  },
  "bugs": {
    "url": "https://github.com/soybeanjs/eslint-config-vue/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "cleanup": "soy cleanup",
    "commit": "soy git-commit",
    "lint": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "prepare": "simple-git-hooks",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy update-pkg"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint-plugin-vue": "^10.9.1",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-define-config": "1.23.0-2",
    "@soybeanjs/cli": "1.7.2",
    "@types/node": "25.9.1",
    "eslint": "^10.4.0",
    "lint-staged": "17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm soy git-commit-verify",
    "pre-commit": "pnpm typecheck && pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxlint . --fix && oxfmt"
  },
  "packageManager": "pnpm@11.2.2"
}
